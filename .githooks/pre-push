#!/bin/sh

set -eu

protected_branch="master"
zero_sha="0000000000000000000000000000000000000000"
remote="${1:-origin}"

version_from_commit() {
    git show "$1:DESCRIPTION" 2>/dev/null |
        awk -F: '/^Version:[[:space:]]*/ {
            sub(/^[[:space:]]*/, "", $2)
            sub(/[[:space:]]*$/, "", $2)
            print $2
            exit
        }'
}

version_is_incremented() {
    old_version="$1"
    new_version="$2"

    Rscript --vanilla -e \
        'args <- commandArgs(TRUE); quit(status = ifelse(utils::compareVersion(args[2], args[1]) > 0, 0, 1))' \
        "$old_version" "$new_version"
}

ensure_commit_available() {
    commit="$1"
    ref="$2"

    git cat-file -e "$commit^{commit}" 2>/dev/null ||
        git fetch --quiet "$remote" "$ref"
    git cat-file -e "$commit^{commit}" 2>/dev/null
}

status=0

while read -r local_ref local_sha remote_ref remote_sha
do
    [ "$remote_ref" = "refs/heads/$protected_branch" ] || continue

    if [ "$local_sha" = "$zero_sha" ]; then
        echo "Refusing to delete protected branch $remote_ref" >&2
        status=1
        continue
    fi

    local_version="$(version_from_commit "$local_sha")"
    if [ -z "$local_version" ]; then
        echo "Refusing to push $local_ref to $remote_ref: DESCRIPTION Version is missing" >&2
        status=1
        continue
    fi

    if [ "$remote_sha" = "$zero_sha" ]; then
        continue
    fi

    if ! ensure_commit_available "$remote_sha" "$remote_ref"; then
        echo "Refusing to push $local_ref to $remote_ref: remote commit $remote_sha is unavailable" >&2
        status=1
        continue
    fi

    remote_version="$(version_from_commit "$remote_sha")"
    if [ -z "$remote_version" ]; then
        echo "Refusing to push $local_ref to $remote_ref: remote DESCRIPTION Version is missing" >&2
        status=1
        continue
    fi

    if ! command -v Rscript >/dev/null 2>&1; then
        echo "Refusing to push $local_ref to $remote_ref: Rscript is required to compare DESCRIPTION Version" >&2
        status=1
        continue
    fi

    if ! version_is_incremented "$remote_version" "$local_version"; then
        echo "Refusing to push $local_ref to $remote_ref: DESCRIPTION Version must be incremented ($remote_version -> $local_version)" >&2
        status=1
    fi
done

exit "$status"
